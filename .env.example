# Copy this file to `.env` and fill in the values from
# Supabase → Project Settings → API (Project URL and the publishable/anon key).
# The publishable key is safe to use in the browser; never put the secret/service_role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key
